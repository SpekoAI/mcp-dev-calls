{
  "name": "@spekoai/mcp-calls",
  "version": "0.5.6",
  "description": "Place real, disclosed phone calls to businesses straight from your coding agent \u2014 the Speko \"AI calls for devs\" MCP. Single self-contained package: `npx @spekoai/mcp-calls init` to set up.",
  "mcpName": "ai.speko/mcp-calls",
  "type": "module",
  "license": "MIT",
  "author": "SpekoAI",
  "homepage": "https://agentvoice.to",
  "bugs": {
    "url": "https://agentvoice.to"
  },
  "keywords": [
    "agentvoice",
    "speko",
    "voice-ai",
    "mcp",
    "model-context-protocol",
    "phone",
    "calls",
    "claude-code",
    "mcp-framework"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "speko": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "server.json",
    "README.md",
    "skills",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npm --prefix ../server run build && tsup && node scripts/postbuild.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@spekoai/sdk": "^0.4.3",
    "mcp-framework": "^0.2.22",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@spekoai/mcp-calls-demo-server": "*",
    "@types/node": "^22.10.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.9"
  }
}
