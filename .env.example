# ═══════════════════════════════════════════════════════════════════════════
#  Speko Calls demo — environment.  Copy to `.env` and fill in.
#  `.env` is gitignored. NEVER commit real keys.
# ═══════════════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────────────
#  Trusted calling core. The default MCP embeds it; remote mode runs it in
#  server/. It holds secrets/state, runs lookup/rails, and calls api.speko.dev.
# ───────────────────────────────────────────────────────────────────────────

# Your Speko API key — get one at https://platform.speko.dev  (raw sk_... or "Bearer sk_...").
SPEKO_API_KEY=

# Signing secret for dial tokens (any long random string).
# Generate one with:  openssl rand -hex 32
SPEKO_DIAL_TOKEN_SECRET=

# Outbound caller-ID (E.164) used as the `from` on every dial. Optional: if unset,
# make_call auto-resolves your account's first outbound-ready number. Set this to
# pin a specific owned number (e.g. +13392308385).
SPEKO_FROM_NUMBER=

# ── Real business lookup (optional) ──
# With a Places key, lookup_business searches Google. With Twilio Lookup, each
# result gets a carrier line-type check (business lines only; mobiles blocked).
# Without Twilio, real lookups fail closed (no confirmed line type → no dial).
GOOGLE_PLACES_API_KEY=
TWILIO_LOOKUP_SID=
TWILIO_LOOKUP_TOKEN=

# ── DEMO mode ──
# Resolve ONE consented target instead of searching Google, so you can record a
# real disclosed call without Places/Twilio keys. Never enable in production.
SPEKO_DEMO=1
SPEKO_DEMO_E164=                  # the number to dial, E.164 (e.g. +12015550123)
SPEKO_DEMO_BUSINESS=Sakura Sushi  # name spoken/shown on the call
SPEKO_DEMO_LINE_TYPE=voip         # asserted line type (bypasses the mobile block for a consented demo)
SPEKO_DEMO_UTC_OFFSET=300         # destination UTC offset in MINUTES. Sign matters: +300 = UTC+5 (Almaty), -300 = US Eastern (EST), -240 US EDT, -420 US Pacific (PDT). Gates 08:00–21:00 quiet hours.
SPEKO_DEMO_ADDRESS=               # optional, cosmetic

# ── server bind (optional) ──
# HOST=127.0.0.1
# PORT=8787

# Optional Speko API base override (defaults to https://api.speko.dev)
# SPEKOAI_API_URL=

# call_me local owner state. `speko me verify` writes owner.json here (0600).
# Defaults to SPEKO_GUARD_STATE_DIR, then ~/.speko/calls.
# SPEKO_OWNER_STATE_DIR=

# Portable owner state for headless installs: the single-line blob printed by
# `speko me export` on a machine with a verified owner. Seeds owner state at
# backend startup ONLY when none exists; an existing owner state always wins.
# Credential-equivalent for ringing that owner number - store it as a secret
# (env/KMS), never in a repo file.
# SPEKO_OWNER_PROFILE=

# Client timeout policy. The init wizard writes the correct target profile.
# Missing/unknown values use safe-default, which forces call_me wait:false.
# SPEKO_CLIENT_PROFILE=safe-default

# Emergency local kill switch for call_me. Owner state remains on disk.
# SPEKO_CALLME_DISABLED=0

# ── Hermetic test mode ──
# SPEKO_TEST_MODE=1 runs every tool as an offline in-process simulation: no key, no
# network, no real dialing; results carry test_mode:true and [SIMULATED] labels.
# Refuses to start with a live sk_* key or with SPEKO_MCP_SERVER_URL set.
# SPEKO_FAKE_NOW (ISO timestamp) overrides test mode's frozen mid-day after-hours
# clock; it is ignored entirely outside test mode.
# SPEKO_TEST_MODE=1
# SPEKO_FAKE_NOW=2026-01-15T21:30:00Z

# ───────────────────────────────────────────────────────────────────────────
#  mcp/  - optional remote-server mode. The default npx install instead runs
#  server core in-process and receives SPEKO_API_KEY from the MCP client config.
# ───────────────────────────────────────────────────────────────────────────

# Where the MCP reaches the backing server.
# Setting this always selects remote mode. Leave it unset for the default embedded core.
# SPEKO_MCP_SERVER_URL=http://127.0.0.1:8787

# Optional shared secret between mcp/ and server/ — set the SAME value on both, or leave blank.
MCP_INTERNAL_KEY=
