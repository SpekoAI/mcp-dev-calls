{
  "name": "@spekoai/mcp-calls-demo-server",
  "private": true,
  "version": "0.1.0",
  "description": "Demo backing API for the Speko calls MCP: Google Places business lookup, server-side safety rails, signed dial tokens, and outbound calling via @spekoai/sdk against api.speko.dev.",
  "type": "module",
  "main": "dist/index.js",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@spekoai/sdk": "^0.4.3",
    "express": "^5.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0"
  }
}
